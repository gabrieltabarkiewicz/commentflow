# --- Database (Postgres) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/commentflow?schema=public"

# --- Segurança ---
# Chave para criptografar os tokens de acesso no banco (AES-256-GCM).
# Gere uma: openssl rand -base64 32
# Se vazio, os tokens ficam em texto puro (ok só em dev). NÃO perca essa chave:
# sem ela, os tokens já criptografados não podem ser lidos.
ENCRYPTION_KEY=""

# --- Meta App (OAuth no painel) ---
# Do seu app em https://developers.facebook.com/ (Configurações > Básico)
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"

# Opcional: URL de callback do OAuth. Se vazio, usa <origin>/api/auth/meta/callback.
# Em local via túnel, ponha a URL pública do túnel, ex.:
# META_REDIRECT_URI="https://SEU-TUNEL/api/auth/meta/callback"
META_REDIRECT_URI=""

# String aleatória que você escolhe; a mesma vai no webhook da Meta.
IG_VERIFY_TOKEN="choose_a_long_random_string"

# --- Fallback manual (opcional) ---
# Depois de conectar pelo painel (OAuth), estes NÃO são necessários.
# Servem só como fallback se você quiser colar um token na mão.
IG_ACCESS_TOKEN=""
IG_USER_ID=""

# Graph API version
GRAPH_API_VERSION="v21.0"
