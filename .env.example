# --- Database (Postgres) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/commentflow?schema=public"

# --- Meta / Instagram Graph API ---
# App secret from your Meta app (used to verify the X-Hub-Signature-256 header)
META_APP_SECRET="your_meta_app_secret"

# A random string you choose; it must match the "Verify token" you type when
# subscribing the webhook in the Meta dashboard.
IG_VERIFY_TOKEN="choose_a_long_random_string"

# Access token with instagram_manage_comments + instagram_manage_messages
IG_ACCESS_TOKEN="your_long_lived_access_token"

# Your Instagram Business user id (used as the sender for comment -> DM replies)
IG_USER_ID="your_ig_business_user_id"

# Graph API version
GRAPH_API_VERSION="v21.0"
